---
import { ClientRouter } from "astro:transitions";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "../styles/globals.css";
import CookieBanner from "../components/cookies/CookieBanner";
import { SITE as SITE_INFO, FOUNDERS } from "../data/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** "article" en las entradas del blog */
  ogType?: "website" | "article";
  /** Datos estructurados adicionales de la página (p. ej. BlogPosting) */
  extraJsonLd?: Record<string, unknown>;
  /** Para páginas en construcción o que no deben indexarse */
  noindex?: boolean;
}

const {
  title,
  description = "Hyperfocus crea software, agentes IA y automatizaciones para empresas que quieren vender más, ahorrar tiempo y operar mejor.",
  ogImage = "/og-image.jpg",
  ogType = "website",
  extraJsonLd,
  noindex = false,
} = Astro.props;

const SITE = Astro.site ?? new URL("https://hyperfocus.es");
const canonical = new URL(Astro.url.pathname, SITE);
const ogImageUrl = new URL(ogImage, SITE);
const GTM_ID = "GTM-P7CTB25W";

// Datos estructurados (SEO local): negocio de servicios profesionales en Toledo.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": SITE_INFO.url + "/#organization",
  name: SITE_INFO.name,
  url: SITE_INFO.url,
  logo: SITE_INFO.url + "/brand/logo_blanco_acento.svg",
  image: SITE_INFO.url + "/og-image.jpg",
  email: SITE_INFO.email,
  telephone: [SITE_INFO.phone, SITE_INFO.phone2].map((t) => t.replace(/ /g, "")),
  description: "Estudio de software a medida, agentes de IA y automatización de procesos para pymes.",
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE_INFO.city,
    addressRegion: SITE_INFO.region,
    addressCountry: "ES",
  },
  areaServed: [
    { "@type": "City", name: SITE_INFO.city },
    { "@type": "Country", name: "España" },
  ],
  founder: FOUNDERS.map((f) => ({ "@type": "Person", name: f.name, jobTitle: f.role })),
  sameAs: [SITE_INFO.instagram, SITE_INFO.linkedin].filter(Boolean),
  knowsAbout: ["Software a medida", "Agentes de IA", "Automatización de procesos", "Desarrollo web"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="Reflexiones · Hyperfocus" href="/reflexiones/rss.xml" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Hyperfocus" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraJsonLd && <script type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />}

    <!-- Intro de portada: solo una vez por sesión (se marca antes de pintar) -->
    <script is:inline>
      document.documentElement.classList.add("hf-js");
      (function () {
        function markIntro() {
          try {
            if (sessionStorage.getItem("hf_intro_seen") === "1") document.documentElement.dataset.introSeen = "1";
          } catch (e) {}
        }
        markIntro();
        // Las transiciones de vista sustituyen los atributos de <html>.
        document.addEventListener("astro:after-swap", function () {
          document.documentElement.classList.add("hf-js");
          markIntro();
        });
      })();
    </script>
    <!-- Google Tag Manager — se carga SOLO tras consentimiento analítico -->
    <script is:inline define:vars={{ GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.loadGTM = function () {
        if (window.__gtmLoaded || !GTM_ID) return;
        window.__gtmLoaded = true;
        window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        const f = document.getElementsByTagName("script")[0];
        const j = document.createElement("script");
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + GTM_ID;
        f.parentNode.insertBefore(j, f);
      };
      try {
        const c = JSON.parse(localStorage.getItem("hyperfocus_cookie_consent") || "null");
        if (c && c.analytics) window.loadGTM();
      } catch (e) {}
      window.addEventListener("hyperfocus:consent-updated", function (e) {
        if (e.detail && e.detail.analytics) window.loadGTM();
      });
    </script>
    <ClientRouter />
    <style>
      html,
      body {
        background: #ffffff !important;
        background-image: none !important;
        overflow-x: hidden;
      }

      /* ── Page transition overlay ────────────────────────── */
      #pt-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.35s ease;
      }
      html[data-intro-seen="1"] .hf-intro {
        display: none;
      }

      /* El botón de WhatsApp no tapa el menú móvil abierto */
      body[style*="overflow: hidden"] .hf-wa {
        display: none;
      }

      #pt-overlay.pt-active {
        opacity: 1;
        pointer-events: auto;
      }

      /* ── Logo animation ─────────────────────────────────────── */
      .pt-logo-wrap {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 50px;
      }

      .pt-logo-track,
      .pt-logo-fill {
        position: absolute;
        inset: 0;
        display: block;
      }

      /* faint outline — the "empty" state of the gauge */
      .pt-logo-track {
        opacity: 0.16;
      }

      /* white fill that rises from the bottom, like the logo filling with color */
      .pt-logo-fill {
        opacity: 0;
        clip-path: inset(100% 0 0 0);
      }

      #pt-overlay.pt-active .pt-logo-fill {
        opacity: 1;
        animation: pt-logo-fill 1.7s cubic-bezier(0.45, 0, 0.2, 1) infinite;
      }

      @keyframes pt-logo-fill {
        0%,
        100% {
          clip-path: inset(100% 0 0 0);
        }
        55% {
          clip-path: inset(0% 0 0 0);
        }
        80% {
          clip-path: inset(0% 0 0 0);
        }
      }
    </style>
  </head>
  <body class="min-h-screen">
    <!-- Transition overlay – persists across navigations -->
    <div id="pt-overlay" transition:persist aria-hidden="true">
      <div class="pt-logo-wrap">
        <img
          class="pt-logo-track"
          src="/brand/logo_oscuro_acento.svg"
          alt=""
          width="48"
          height="50"
          aria-hidden="true"
        />
        <img class="pt-logo-fill" src="/brand/logo_oscuro_acento.svg" alt="Hyperfocus" width="48" height="50" />
      </div>
    </div>

    <slot />

    <CookieBanner client:idle />

    <!-- Botón flotante de WhatsApp -->
    <a
      href={SITE_INFO.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={"Escríbenos por WhatsApp al " + SITE_INFO.phone}
      class="hf-wa fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-ink shadow-[0_10px_30px_rgba(37,211,102,0.35)] transition hover:scale-105 sm:bottom-6 sm:right-6"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.42 9.43-9.42 2.52 0 4.88.98 6.66 2.76a9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.23 9.42-9.42 9.42m8.02-17.44A11.27 11.27 0 0 0 12.05.75C5.8.75.72 5.83.72 12.08c0 2 .52 3.95 1.52 5.66L.62 23.25l5.65-1.48a11.3 11.3 0 0 0 5.78 1.47h.01c6.25 0 11.33-5.08 11.33-11.33 0-3.03-1.18-5.87-3.32-8.01" />
      </svg>
    </a>

    <script>
      function resetLogo() {
        const fill = document.querySelector<HTMLImageElement>(".pt-logo-fill");
        if (!fill) return;
        fill.style.animation = "none";
        void fill.getBoundingClientRect();
        fill.style.animation = "";
      }

      const NO_OVERLAY_PATHS = ["/", "/aviso-legal", "/privacidad", "/cookies"];

      document.addEventListener("astro:before-preparation", (e) => {
        const destination = (e as Event & { to?: URL }).to;
        if (destination && NO_OVERLAY_PATHS.includes(destination.pathname)) return;
        resetLogo();
        document.getElementById("pt-overlay")?.classList.add("pt-active");
      });

      // El overlay se quita en cuanto la nueva página está lista (sin espera fija).
      document.addEventListener("astro:page-load", () => {
        document.getElementById("pt-overlay")?.classList.remove("pt-active");
      });

      // Aparición al hacer scroll de los elementos .hf-reveal (páginas .astro)
      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>(".hf-reveal:not(.is-visible)");
        if (!("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((el) => io.observe(el));
      }

      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
