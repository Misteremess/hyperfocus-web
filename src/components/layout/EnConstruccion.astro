---
import HomeNav from "../home/HomeNav";
import Footer from "./Footer.astro";

interface Props {
  tag: string;
  title: string;
  subtitle?: string;
}
const { tag, title, subtitle } = Astro.props;
---

<HomeNav client:load />
<main class="flex min-h-screen flex-col items-center justify-center bg-paper px-6 pb-24 pt-28 text-center">
  <p class="hf-hero-in mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-ink/55">{tag}</p>
  <h1
    class="hf-hero-in max-w-2xl text-3xl font-semibold leading-[1.15] tracking-[-0.03em] text-ink sm:text-4xl lg:text-5xl"
    style="--hf-delay: 80ms"
  >
    {title}
  </h1>
  {subtitle && (
    <p class="hf-hero-in mt-5 max-w-md text-[15px] leading-[1.75] text-ink/65" style="--hf-delay: 160ms">
      {subtitle}
    </p>
  )}
  <div class="hf-hero-in mt-10 flex flex-col gap-3 sm:flex-row" style="--hf-delay: 240ms">
    <a
      href="/contacto"
      class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-[14px] font-semibold text-paper transition hover:bg-ink/90"
    >
      Hablar con nosotros{" "}
      <span aria-hidden="true" class="text-[11px]">
        →
      </span>
    </a>
    <a
      href="/"
      class="inline-flex items-center justify-center rounded-full border border-ink/30 px-6 py-3 text-[14px] font-medium text-ink transition hover:border-ink/60 hover:bg-ink/10"
    >
      Volver al inicio
    </a>
  </div>
</main>
<Footer />
