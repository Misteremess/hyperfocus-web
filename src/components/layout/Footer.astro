---
// Pie de página (HTML estático, sin React). El botón «Configurar cookies»
// lanza el evento que escucha CookieBanner para reabrir el panel.
import { SITE, FOOTER_COLUMNS, LEGAL_LINKS } from "../../data/site";

const year = new Date().getFullYear();
const WHATSAPP_PATH =
  "M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.93.95-3.48-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.19 4.23-9.42 9.43-9.42 2.52 0 4.88.98 6.66 2.76a9.36 9.36 0 0 1 2.76 6.67c0 5.2-4.23 9.42-9.42 9.42m8.02-17.44A11.27 11.27 0 0 0 12.05.75C5.8.75.72 5.83.72 12.08c0 2 .52 3.95 1.52 5.66L.62 23.25l5.65-1.48a11.3 11.3 0 0 0 5.78 1.47h.01c6.25 0 11.33-5.08 11.33-11.33 0-3.03-1.18-5.87-3.32-8.01";
---

<!-- Pie en azul marino: .theme-dark invierte ink/paper dentro del pie -->
<footer class="theme-dark relative overflow-hidden bg-paper text-ink">
  <div
    class="pointer-events-none absolute -left-40 -top-40 h-[520px] w-[520px] rounded-full blur-3xl"
    style="background: radial-gradient(circle, rgba(56,189,248,0.14), transparent 65%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 px-6 lg:px-8">
    <div class="flex flex-col gap-12 py-16 lg:flex-row lg:items-start lg:justify-between lg:gap-16 lg:py-28">
      <div class="flex max-w-lg flex-col gap-8">
        <p class="text-3xl font-semibold leading-[1.08] tracking-[-0.03em] text-ink sm:text-4xl lg:text-5xl xl:text-6xl">
          Software, IA y automatización hechos en {SITE.city}.
        </p>
        <a href="/" aria-label="Hyperfocus, ir al inicio" class="self-start">
          <img src="/brand/logo_blanco_acento.svg" alt="" width="145" height="150" class="h-10 w-auto sm:h-12" />
        </a>
        <address class="not-italic text-[13px] leading-[1.9] text-ink/65">
          {SITE.city}, {SITE.region} · España
          <br />
          <a href={`mailto:${SITE.email}`} class="transition hover:text-ink">
            {SITE.email}
          </a>
          <br />
          <a href={SITE.phoneHref} class="whitespace-nowrap transition hover:text-ink">
            {SITE.phone}
          </a>
          {" · "}
          <a href={SITE.phone2Href} class="whitespace-nowrap transition hover:text-ink">
            {SITE.phone2}
          </a>
          <br />
          <a
            href={SITE.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-emerald-300 transition hover:text-ink"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={WHATSAPP_PATH} />
            </svg>
            Escríbenos por WhatsApp
          </a>
          {SITE.booking && (
            <>
              {" · "}
              <a href={SITE.booking} target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">
                Reservar una llamada
              </a>
            </>
          )}
        </address>
      </div>

      <nav
        class="grid grid-cols-2 gap-x-8 gap-y-10 lg:flex lg:shrink-0 lg:gap-16 lg:pt-1 lg:text-right"
        aria-label="Pie de página"
      >
        {FOOTER_COLUMNS.map((col) => (
          <div>
            <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/55">{col.title}</p>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[13px] text-ink/70 transition hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="flex flex-col gap-6 border-t border-ink/10 py-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-ink/60">
        <p>
          © {year} {SITE.name}. Todos los derechos reservados.
        </p>
        {LEGAL_LINKS.map((l) => (
          <a href={l.href} class="transition hover:text-ink">
            {l.label}
          </a>
        ))}
        <button type="button" data-open-cookie-settings class="transition hover:text-ink">
          Configurar cookies
        </button>
      </div>
      <div class="flex gap-5">
        <a
          href={SITE.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-ink/60 transition hover:text-ink"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
        {SITE.linkedin && (
          <a
            href={SITE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-ink/60 transition hover:text-ink"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</footer>

<script>
  // Delegación: funciona tras cada navegación con transiciones sin volver a enganchar.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest("[data-open-cookie-settings]")) {
      window.dispatchEvent(new Event("hyperfocus:open-cookie-settings"));
    }
  });
</script>
