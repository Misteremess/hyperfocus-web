---
interface Props {
  title: string;
  intro: string;
  steps: { title: string; desc: string }[];
}
const { title, intro, steps } = Astro.props;
---

<section id="como-trabajamos" class="scroll-mt-20 border-t border-ink/10 px-6 py-16 sm:py-24 lg:px-8">
  <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-16">
    <div class="w-full shrink-0 lg:sticky lg:top-28 lg:w-[28%]">
      <h2 class="hf-reveal text-[1.75rem] font-semibold leading-[1.1] tracking-[-0.035em] text-ink sm:text-3xl lg:text-4xl">
        {title}
      </h2>
      <p class="hf-reveal mt-5 text-[15px] leading-[1.75] text-ink/65">{intro}</p>
      <a
        href="/contacto"
        class="hf-reveal mt-8 inline-flex items-center gap-2 rounded-full border border-ink/25 px-6 py-2.5 text-[14px] font-medium text-ink transition-all duration-200 hover:border-ink/60 hover:bg-ink/10"
      >
        Empezar proyecto{" "}
        <span class="text-[11px] opacity-70" aria-hidden="true">
          →
        </span>
      </a>
    </div>

    <ol class="relative flex-1">
      <!-- Línea vertical que une los pasos -->
      <span
        class="absolute bottom-8 left-[13px] top-8 w-px bg-gradient-to-b from-ink/25 via-ink/10 to-transparent"
        aria-hidden="true"
      ></span>
      {steps.map((step, i) => (
        <li class="hf-reveal relative flex items-start gap-6 py-7" style={`--hf-delay: ${i * 100}ms`}>
          <span class="relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink/25 bg-paper text-[11px] font-semibold text-ink">
            {i + 1}
          </span>
          <div>
            <h3 class="text-[16px] font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-[14px] leading-[1.72] text-ink/65">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
