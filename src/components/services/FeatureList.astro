---
import Icon from "./Icon.astro";

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: { icon: string; label: string; desc: string }[];
  demo?: { image: string; alt: string; badge: string };
}
const { eyebrow, title, intro, items, demo } = Astro.props;
---

<section class="border-t border-ink/10 px-6 py-16 sm:py-24 lg:px-8">
  <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-16">
    <div class:list={["w-full shrink-0", demo ? "lg:w-[38%]" : "lg:w-[36%]"]}>
      <p class="hf-reveal mb-4 text-[11px] font-semibold uppercase tracking-[0.26em] text-ink/55">{eyebrow}</p>
      <h2 class="hf-reveal mb-5 text-[1.75rem] font-semibold leading-[1.1] tracking-[-0.035em] text-ink sm:text-3xl lg:text-4xl">
        {title}
      </h2>
      <p class="hf-reveal text-[15px] leading-[1.75] text-ink/65">{intro}</p>

      {demo && (
        <ul class="mt-8">
          {items.map((s, i) => (
            <li
              class="hf-reveal group flex items-start gap-4 border-t border-ink/10 py-5"
              style={`--hf-delay: ${i * 80}ms`}
            >
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-ink/12 text-ink/70 transition-colors group-hover:border-ink/30 group-hover:text-ink">
                <Icon name={s.icon} />
              </span>
              <div>
                <h3 class="text-[14px] font-semibold text-ink">{s.label}</h3>
                <p class="mt-1 text-[13px] leading-[1.7] text-ink/65">{s.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>

    {demo ? (
      <figure class="hf-reveal flex-1 lg:sticky lg:top-28">
        <div class="overflow-hidden rounded-2xl border border-ink/10 bg-surface shadow-[0_30px_60px_-30px_rgba(11,27,51,0.35)]">
          <img
            src={demo.image}
            alt={demo.alt}
            width="900"
            height="900"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] h-full w-full object-cover object-top"
          />
        </div>
        <figcaption class="mt-3 text-[12px] text-ink/55">
          {demo.badge} · diseño de ejemplo, no es un proyecto de cliente.
        </figcaption>
      </figure>
    ) : (
      <ul class="grid flex-1 gap-4 sm:grid-cols-2">
        {items.map((s, i) => (
          <li
            class="hf-reveal group rounded-2xl border border-ink/10 bg-paper p-6 shadow-[0_1px_2px_rgba(11,27,51,0.04)] transition duration-300 hover:-translate-y-1 hover:border-ink/20 hover:shadow-[0_20px_40px_-20px_rgba(11,27,51,0.25)]"
            style={`--hf-delay: ${i * 80}ms`}
          >
            <span class="mb-5 flex h-10 w-10 items-center justify-center rounded-xl border border-ink/15 text-ink/75 transition-colors group-hover:border-sky-600/50 group-hover:text-sky-700">
              <Icon name={s.icon} size={18} />
            </span>
            <h3 class="text-[15px] font-semibold text-ink">{s.label}</h3>
            <p class="mt-2 text-[13px] leading-[1.7] text-ink/65">{s.desc}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
