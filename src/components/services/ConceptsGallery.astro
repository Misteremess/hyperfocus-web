---
// Rejilla de diseños de ejemplo. Se rotulan como «Concepto» para que no se
// confundan con proyectos entregados a clientes. Al hacer clic se amplían.
interface Props {
  items: { name: string; sector: string; image: string }[];
}
const { items } = Astro.props;
---

<section class="border-t border-ink/10 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-10 flex flex-col gap-4 sm:mb-12 sm:flex-row sm:items-end sm:justify-between">
      <div class="hf-reveal max-w-2xl">
        <p class="mb-4 text-[12px] font-semibold uppercase tracking-[0.2em] text-brand">Ideas para tu negocio</p>
        <h2 class="text-2xl font-semibold tracking-[-0.035em] text-ink sm:text-3xl lg:text-4xl">
          Ejemplos de lo que podemos construir.
        </h2>
        <p class="mt-3 text-[15px] leading-[1.7] text-ink/65">
          Diseños de concepto para que te hagas una idea. No son proyectos de clientes: cada solución se diseña a partir
          de tu caso.
        </p>
      </div>
      <a href="/contacto" class="hf-reveal shrink-0 text-[14px] font-medium text-brand hover:underline">
        Cuéntanos el tuyo →
      </a>
    </div>

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((c, i) => (
        <li class="hf-reveal" style={`--hf-delay: ${(i % 3) * 80}ms`}>
          <button
            type="button"
            data-zoom-src={c.image}
            data-zoom-alt={`Diseño de concepto: ${c.name}`}
            class="group block w-full cursor-zoom-in overflow-hidden rounded-2xl border border-ink/10 bg-paper text-left shadow-[0_1px_2px_rgba(11,27,51,0.04)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgba(11,27,51,0.35)]"
          >
            <div class="aspect-[4/3] overflow-hidden bg-surface">
              <img
                src={c.image}
                alt={`Diseño de concepto: ${c.name}`}
                width="900"
                height="900"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.03]"
              />
            </div>
            <div class="border-t border-ink/10 p-5">
              <span class="text-[12px] font-medium uppercase tracking-[0.14em] text-ink/55">Concepto · {c.sector}</span>
              <h3 class="mt-1.5 text-[16px] font-semibold leading-[1.3] text-ink">{c.name}</h3>
            </div>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<dialog
  id="hf-zoom"
  class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl border border-ink/10 bg-paper p-0 shadow-2xl backdrop:bg-ink/70 backdrop:backdrop-blur-sm"
>
  <form method="dialog" class="absolute right-3 top-3">
    <button class="rounded-full border border-ink/15 bg-paper px-4 py-1.5 text-[13px] font-medium text-ink shadow">
      Cerrar
    </button>
  </form>
  <img id="hf-zoom-img" src="" alt="" class="block max-h-[92vh] w-auto" />
</dialog>

<script>
  // Delegación: funciona tras cada navegación con transiciones.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>("[data-zoom-src]");
    const dialog = document.getElementById("hf-zoom") as HTMLDialogElement | null;
    if (dialog && e.target === dialog) dialog.close(); // clic fuera de la imagen
    if (!btn || !dialog) return;
    const img = document.getElementById("hf-zoom-img") as HTMLImageElement;
    img.src = btn.dataset.zoomSrc!;
    img.alt = btn.dataset.zoomAlt ?? "";
    dialog.showModal();
  });
</script>
