---
import HomeLayout from "../../layouts/HomeLayout.astro";
import HomeNav from "../../components/home/HomeNav";
import Footer from "../../components/layout/Footer.astro";
import { getPublishedPosts, readingTime, formatDate } from "../../lib/blog";

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
---

<HomeLayout
  title="Reflexiones · Ideas sobre software, IA y automatización para pymes | Hyperfocus"
  description="Artículos prácticos sobre IA, automatización, software a medida y licitaciones públicas para pymes, escritos por el equipo de Hyperfocus (Toledo)."
>
  <HomeNav client:load />
  <main class="min-h-screen bg-paper px-6 pb-24 pt-32 sm:pt-40 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <header class="mb-14 max-w-3xl sm:mb-20">
        <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.26em] text-ink/55">Reflexiones</p>
        <h1 class="text-[2.25rem] font-semibold leading-[1.06] tracking-[-0.04em] text-ink sm:text-5xl lg:text-[4rem]">
          Lo que aprendemos haciendo, contado sin humo.
        </h1>
        <p class="mt-6 text-[16px] leading-[1.75] text-ink/70">
          Ideas prácticas sobre IA, automatización, software a medida y licitaciones públicas para pymes.
        </p>
      </header>

      {posts.length === 0 && <p class="text-[15px] text-ink/65">Pronto publicaremos los primeros artículos.</p>}

      {featured && (
        <a
          href={`/reflexiones/${featured.id}/`}
          class="hf-reveal group relative mb-6 block overflow-hidden rounded-3xl border border-ink/10 bg-ink/[0.03] p-7 transition duration-300 hover:-translate-y-1 hover:border-ink/25 sm:p-10 lg:p-12"
        >
          <div
            class="pointer-events-none absolute inset-0 opacity-60 transition-opacity duration-500 group-hover:opacity-100"
            style="background: radial-gradient(ellipse at 85% 0%, rgba(79,214,255,0.12), transparent 55%), radial-gradient(ellipse at 10% 100%, rgba(16,185,129,0.10), transparent 50%);"
            aria-hidden="true"
          />
          <div class="relative z-10 max-w-3xl">
            <p class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink/60">
              <span class="rounded-full border border-ink/20 px-3 py-1 text-ink/80">{featured.data.category}</span>
              <span>{formatDate(featured.data.pubDate)}</span>
              <span aria-hidden="true">·</span>
              <span>{readingTime(featured)} min de lectura</span>
            </p>
            <h2 class="text-[1.6rem] font-semibold leading-[1.15] tracking-[-0.03em] text-ink sm:text-[2.25rem]">
              {featured.data.title}
            </h2>
            <p class="mt-4 text-[15px] leading-[1.75] text-ink/65">{featured.data.description}</p>
            <span class="mt-7 inline-flex items-center gap-1.5 text-[14px] font-medium text-ink">
              Leer artículo{" "}
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
                →
              </span>
            </span>
          </div>
        </a>
      )}

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((post, i) => (
          <a
            href={`/reflexiones/${post.id}/`}
            class="hf-reveal group flex flex-col rounded-2xl border border-ink/10 bg-ink/[0.03] p-7 transition duration-300 hover:-translate-y-1 hover:border-ink/25"
            style={`--hf-delay: ${(i % 3) * 80}ms`}
          >
            <p class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-ink/60">
              <span class="text-ink/80">{post.data.category}</span>
              <span aria-hidden="true">·</span>
              <span>{readingTime(post)} min</span>
            </p>
            <h2 class="text-[19px] font-semibold leading-[1.3] tracking-[-0.02em] text-ink">{post.data.title}</h2>
            <p class="mt-3 flex-1 text-[14px] leading-[1.7] text-ink/65">{post.data.description}</p>
            <p class="mt-6 text-[12px] text-ink/50">{formatDate(post.data.pubDate)}</p>
          </a>
        ))}
      </div>

      <p class="mt-14 text-[13px] text-ink/55">
        ¿Prefieres recibirlos en tu lector?{" "}
        <a href="/reflexiones/rss.xml" class="text-ink/80 underline underline-offset-4">
          Suscríbete por RSS
        </a>
        .
      </p>
    </div>
  </main>
  <Footer />
</HomeLayout>
