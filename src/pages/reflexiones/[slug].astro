---
import { render } from "astro:content";
import HomeLayout from "../../layouts/HomeLayout.astro";
import HomeNav from "../../components/home/HomeNav";
import Footer from "../../components/layout/Footer.astro";
import { getPublishedPosts, readingTime, formatDate, RELATED_CTA } from "../../lib/blog";
import { SITE } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i + 1] ?? posts[0] },
  }));
}

const { post, next } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/reflexiones/${post.id}/`, SITE.url).toString();
const cta = post.data.related ? RELATED_CTA[post.data.related] : null;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: "es-ES",
  mainEntityOfPage: url,
  author: { "@type": post.data.author === "Equipo Hyperfocus" ? "Organization" : "Person", name: post.data.author },
  publisher: { "@id": SITE.url + "/#organization" },
};
---

<HomeLayout
  title={`${post.data.title} | Hyperfocus`}
  description={post.data.description}
  ogType="article"
  extraJsonLd={articleLd}
>
  <HomeNav client:load />
  <main class="bg-paper px-6 pb-24 pt-32 sm:pt-40 lg:px-8">
    <!-- Barra de progreso de lectura -->
    <div
      class="fixed left-0 top-0 z-[60] h-[2px] w-full origin-left bg-gradient-to-r from-sky-500 via-violet-500 to-emerald-500"
      id="hf-progress"
      style="transform: scaleX(0)"
      aria-hidden="true"
    ></div>

    <article class="mx-auto max-w-[720px]">
      <a
        href="/reflexiones/"
        class="mb-10 inline-flex items-center gap-2 text-[13px] text-ink/60 transition hover:text-ink"
      >
        <span aria-hidden="true">←</span> Reflexiones
      </a>
      <header class="mb-12 border-b border-ink/10 pb-10">
        <p class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink/60">
          <span class="rounded-full border border-ink/20 px-3 py-1 text-ink/80">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post)} min de lectura</span>
        </p>
        <h1 class="text-[2rem] font-semibold leading-[1.1] tracking-[-0.035em] text-ink sm:text-[2.75rem]">
          {post.data.title}
        </h1>
        <p class="mt-5 text-[17px] leading-[1.7] text-ink/70">{post.data.description}</p>
        <p class="mt-6 text-[13px] text-ink/55">Por {post.data.author}</p>
      </header>

      <div class="hf-prose hf-prose-article">
        <Content />
      </div>

      {cta && (
        <aside class="relative mt-16 overflow-hidden rounded-2xl border border-ink/10 bg-ink/[0.03] p-7 sm:p-9">
          <div
            class="pointer-events-none absolute inset-0"
            style="background: radial-gradient(ellipse at 90% 0%, rgba(16,185,129,0.12), transparent 60%);"
            aria-hidden="true"
          />
          <div class="relative z-10">
            <p class="text-[20px] font-semibold tracking-[-0.02em] text-ink">{cta.title}</p>
            <p class="mt-2 text-[14px] leading-[1.7] text-ink/65">{cta.text}</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a
                href={cta.href}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-[14px] font-semibold text-paper transition hover:bg-ink/90"
              >
                {cta.label}{" "}
                <span aria-hidden="true" class="text-[11px]">
                  →
                </span>
              </a>
              <a
                href="/contacto"
                class="inline-flex items-center justify-center rounded-full border border-ink/30 px-6 py-3 text-[14px] font-medium text-ink transition hover:border-ink/60 hover:bg-ink/10"
              >
                Hablar con nosotros
              </a>
            </div>
          </div>
        </aside>
      )}

      {next && next.id !== post.id && (
        <a
          href={`/reflexiones/${next.id}/`}
          class="group mt-10 block rounded-2xl border border-ink/10 p-7 transition hover:border-ink/25"
        >
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-ink/55">Siguiente lectura</p>
          <p class="mt-3 text-[18px] font-semibold leading-[1.3] text-ink">
            {next.data.title}{" "}
            <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">
              →
            </span>
          </p>
        </a>
      )}
    </article>
  </main>
  <Footer />
</HomeLayout>

<script>
  // Progreso de lectura (se vuelve a enganchar en cada navegación con transiciones)
  function initProgress() {
    const bar = document.getElementById("hf-progress");
    if (!bar) return;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    document.addEventListener("astro:before-swap", () => window.removeEventListener("scroll", update), { once: true });
  }
  document.addEventListener("astro:page-load", initProgress);
</script>
