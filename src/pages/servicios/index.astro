---
import { getCollection } from "astro:content";
import HomeLayout from "../../layouts/HomeLayout.astro";
import HomeNav from "../../components/home/HomeNav";
import Footer from "../../components/layout/Footer.astro";

const services = (await getCollection("servicios")).sort((a, b) => a.data.order - b.data.order);
---

<HomeLayout
  title="Servicios | Hyperfocus"
  description="Software a medida, agentes de IA, automatización y webs para pymes. Estudio en Toledo con trato directo."
>
  <HomeNav client:load />
  <main class="min-h-screen bg-paper px-6 pb-24 pt-28 sm:pt-32 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="hf-hero-in mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-ink/55">Servicios</p>
      <h1
        class="hf-hero-in max-w-2xl text-3xl font-semibold leading-[1.1] tracking-[-0.03em] text-ink sm:text-4xl lg:text-5xl"
        style="--hf-delay: 80ms"
      >
        Lo que construimos.
      </h1>
      <p class="hf-hero-in mt-5 max-w-xl text-[15px] leading-[1.75] text-ink/65" style="--hf-delay: 160ms">
        Cuatro formas de resolver un problema técnico real. Todas con el mismo estándar: código limpio, trato directo y
        entregas que puedes probar.
      </p>

      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-ink/10 bg-ink/10 sm:grid-cols-2">
        {services.map((s, i) => (
          <a
            href={`/servicios/${s.id}`}
            class="hf-reveal group flex flex-col gap-3 bg-paper p-8 transition-colors duration-300 hover:bg-ink/[0.04] lg:p-10"
            style={`--hf-delay: ${i * 70}ms`}
          >
            <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-ink lg:text-[22px]">{s.data.card.title}</h2>
            <p class="text-[14px] leading-[1.7] text-ink/65">{s.data.card.desc}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-[13px] text-ink/70 transition-colors group-hover:text-ink">
              Ver servicio{" "}
              <span
                class="text-[11px] opacity-70 transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </span>
          </a>
        ))}
      </div>

      <a
        href="/elevate"
        class="hf-reveal group mt-6 flex flex-col gap-2 rounded-2xl border border-emerald-400/25 bg-emerald-400/[0.04] p-8 transition hover:border-emerald-300/50 sm:flex-row sm:items-center sm:justify-between lg:p-10"
      >
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-emerald-700">Producto propio</p>
          <p class="mt-2 text-[20px] font-semibold tracking-[-0.02em] text-ink">
            Elevate · Alertas de licitaciones públicas con IA
          </p>
        </div>
        <span class="text-[13px] text-ink/75 group-hover:text-ink">Conocer Elevate →</span>
      </a>
    </div>
  </main>
  <Footer />
</HomeLayout>
