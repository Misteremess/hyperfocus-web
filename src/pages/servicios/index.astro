---
import HomeLayout from "../../layouts/HomeLayout.astro";
import HomeNav from "../../components/home/HomeNav";
import Footer from "../../components/layout/Footer";

const SERVICES = [
  {
    href: "/servicios/software",
    title: "Software a medida",
    desc: "Plataformas SaaS, APIs, herramientas internas e infraestructura. Construido desde cero para tu negocio.",
  },
  {
    href: "/servicios/agentes-ia",
    title: "Agentes de IA",
    desc: "Agentes que atienden, cualifican y venden por WhatsApp, email, web y voz — con la personalidad de tu marca.",
  },
  {
    href: "/servicios/automatizacion",
    title: "Automatización",
    desc: "Conectamos tus herramientas y eliminamos el trabajo manual repetitivo con flujos que corren solos.",
  },
  {
    href: "/servicios/webs",
    title: "Webs y aplicaciones",
    desc: "Landings de alta conversión, webs corporativas y aplicaciones web rápidas, accesibles y a medida.",
  },
];
---

<HomeLayout
  title="Servicios | Hyperfocus"
  description="Software a medida, agentes de IA, automatización y webs. Lo que construimos en Hyperfocus para empresas que quieren avanzar."
>
  <HomeNav client:load />
  <main class="min-h-screen bg-[#040506] px-6 pb-24 pt-28 sm:pt-32 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-white/30">
        Servicios
      </p>
      <h1 class="max-w-2xl text-3xl font-semibold leading-[1.1] tracking-[-0.03em] text-white sm:text-4xl lg:text-5xl">
        Lo que construimos.
      </h1>
      <p class="mt-5 max-w-xl text-[15px] leading-[1.75] text-white/40">
        Cuatro formas de resolver un problema técnico real. Todas con el mismo
        estándar: código limpio, trato directo y entregas que puedes probar.
      </p>

      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-white/8 bg-white/8 sm:grid-cols-2">
        {SERVICES.map((s) => (
          <a
            href={s.href}
            class="group flex flex-col gap-3 bg-[#040506] p-8 transition-colors duration-200 hover:bg-white/[0.03] lg:p-10"
          >
            <h2 class="text-[20px] font-semibold tracking-[-0.02em] text-white lg:text-[22px]">
              {s.title}
            </h2>
            <p class="text-[14px] leading-[1.7] text-white/40">{s.desc}</p>
            <span class="mt-2 inline-flex items-center gap-1 text-[13px] text-white/50 transition-colors group-hover:text-white">
              Ver servicio
              <span class="text-[11px] opacity-70">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer client:visible />
</HomeLayout>
