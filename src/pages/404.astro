---
import HomeLayout from "../layouts/HomeLayout.astro";
import HomeNav from "../components/home/HomeNav";
import Footer from "../components/layout/Footer";
---

<HomeLayout title="Página no encontrada | Hyperfocus" description="La página que buscas no existe o se ha movido.">
  <HomeNav client:load />
  <main class="flex min-h-screen flex-col items-center justify-center bg-[#040506] px-6 pb-24 pt-28 text-center">
    <p class="mb-4 text-[10px] font-semibold uppercase tracking-[0.28em] text-white/30">
      Error 404
    </p>
    <h1 class="max-w-xl text-3xl font-semibold leading-[1.15] tracking-[-0.03em] text-white sm:text-4xl lg:text-5xl">
      Esta página no existe.
    </h1>
    <p class="mt-5 max-w-md text-[14px] leading-[1.75] text-white/40">
      Puede que el enlace esté roto o que la página se haya movido. Volvamos a terreno conocido.
    </p>
    <a
      href="/"
      class="mt-9 inline-flex items-center gap-2 rounded-full border border-white/25 px-6 py-2.5 text-[14px] font-medium text-white transition-all duration-200 hover:border-white/55 hover:bg-white/10"
    >
      Volver al inicio
      <span class="text-[11px] opacity-60">→</span>
    </a>
  </main>
  <Footer client:visible />
</HomeLayout>
